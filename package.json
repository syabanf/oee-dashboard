{
  "name": "oee-andon-system",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo dev",
    "dev:admin": "turbo dev --filter=@oee/admin",
    "build": "turbo build",
    "preview:admin": "pnpm --filter @oee/admin preview",
    "typecheck": "turbo typecheck",
    "format": "prettier -w .",
    "gen:fixtures": "tsx scripts/generate-fixtures.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
